[Unit]
Description=HexStrike AI - Security Tools API Server
After=network.target
# ExecStartPost below refuses a non-loopback bind. Without a start limit,
# Restart=on-failure would retry that refusal every 5s forever; three strikes
# leaves the unit failed and visible instead of looping in the journal.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/tools/hexstrike-ai
ExecStart=%h/tools/hexstrike-ai/hexstrike-env/bin/python3 %h/tools/hexstrike-ai/hexstrike_server.py --port 8888
# Verify what the socket actually bound to, and stop the service if it is not
# loopback -- or if the bind cannot be observed at all within the guard's 15s
# deadline, since "unverified" and "safe" are not the same answer. See the NOTE
# at the bottom for why this exists alongside the install-time source rewrite.
#
# The `+` is load-bearing: it runs the guard outside this unit's sandbox. The
# guard asks ss which pid owns the listening socket, and ss needs to read
# /proc/<MainPID>/fd to answer. From inside the sandbox it cannot -- a --user
# unit's mount namespace comes with its own user namespace, so every ss line
# arrives with no users:(...) field and the check matches nothing and takes a
# healthy service down. Without `+`, the guard can only ask the weaker "is
# anything at all on loopback:8888". Nothing is escalated: a user unit has no
# privileges to regain, and the guard reads sockets and exits.
ExecStartPost=+%h/.local/bin/hexstrike-assert-loopback
# Pinned, not inherited. The guard's deadline is only meaningful if it expires
# before systemd's: this user manager's DefaultTimeoutStartUSec is 15s, which
# is the same as the guard's own wait, so the start job was being killed at
# the same moment the guard was about to report *why* it failed. A generic
# "start-post operation timed out" is the one failure message that tells the
# next person nothing.
TimeoutStartSec=45
Restart=on-failure
RestartSec=5
Environment=HEXSTRIKE_HOST=127.0.0.1
Environment=HEXSTRIKE_PORT=8888

# Resource limits -- the backend can get heavy when agents fan out across
# 150+ security tools. Tune these up if you hit ceilings.
Nice=10
CPUQuota=80%
MemoryMax=4G
TasksMax=512

# Hardening for a loopback-only service
ProtectSystem=strict
# read-only rather than tmpfs: hexstrike is meant to read targets and wordlists
# out of $HOME. The mask below is what keeps that from meaning "and every
# credential too".
ProtectHome=read-only
ReadWritePaths=%h/tools/hexstrike-ai
# The threat this unit exists to contain is a file-read primitive first:
# /api/command is unauthenticated and runs arbitrary shell as this same UID, so
# 0600 modes stop nothing. This used to mask .ssh and .gnupg only, which left a
# live OAuth token in ~/.claude/.credentials.json and the login keyring one
# `cat` away. The leading `-` makes a not-yet-existing path a no-op, so the
# entries for tools that aren't installed here cost nothing and mean the list
# doesn't have to be revisited the day one is.
InaccessiblePaths=-%h/.ssh -%h/.gnupg -%h/.claude -%h/.local/share/keyrings -%h/.aws -%h/.config/gh -%h/.config/gcloud -%h/.netrc -%h/.docker -%h/.kube
# PrivatePIDs=yes is deliberately NOT here, though the obvious bypass of the
# mask above is /proc/<pid>/root/... of some unsandboxed process of this same
# UID. Two measured reasons. It is not needed: ProtectSystem=/ProtectHome=
# already put this unit in a child user namespace (a --user manager needs one
# to build the mount sandbox), and ptrace_may_access denies /proc/<pid>/root
# across that boundary -- reading /proc/<niri-pid>/root/home/<user>/.ssh from
# in here is EACCES with these settings and succeeds without them. And it is
# actively harmful. It was tried here: under PrivatePIDs the $MAINPID systemd
# exports to ExecStartPost= names the short-lived intermediate fork that sets
# the namespace up, which is dead by the time the guard runs. The guard passed
# in 23ms while Flask bound 627ms later -- a rubber stamp on the one check
# that inspects the property that matters. It breaks the guard's pid-scoped
# socket lookup for the same reason. Both of those fail closed now rather than
# passing silently, but a setting that buys nothing here and costs that much
# does not belong in the file.
PrivateTmp=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# NOTE: IPAddressAllow=/IPAddressDeny= used to live here. They never did
# anything. systemd's IP firewall is a cgroup BPF feature the *user* manager
# cannot install, and it logs exactly that on every start:
#   "unit configures an IP firewall, but not running as root"
# Confinement to loopback is enforced where it actually works, in two places.
# `dotctl install` rewrites hexstrike_server.py's hardcoded
# `app.run(host="0.0.0.0")` to honour API_HOST, which the HEXSTRIKE_HOST above
# sets — but that is a Rust program pattern-matching one line in a 17k-line
# upstream file, so it can only fail closed on drift it recognises.
# ExecStartPost= then checks the socket itself, which is the property actually
# worth guaranteeing rather than a proxy for it, and takes the service down if
# it bound anywhere else. This API is UNAUTHENTICATED and /api/command executes
# arbitrary shell — never expose it off loopback.

[Install]
WantedBy=default.target
