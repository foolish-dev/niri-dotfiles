#!/usr/bin/env bash
# dotfiles-check -- post-deploy health check.
# Verifies that user systemd units and the Noctalia shell actually came up,
# and that every symlink `dotctl deploy` creates still exists, is still a
# symlink, still points into the dotfiles repo, and still RESOLVES. Designed
# to catch silent failures -- units that were "enabled" but fail on every
# session start, or links left pointing at a path that has since gone away.
# Then what `dotctl install` sets up: the programs the configs call,
# HexStrike's Host guard, the keyring secrets and the GitHub token's expiry,
# the pkgfile database, the theme pipeline, the login screens, the wallpapers.
#
# The resolve half is what was missing, and it certified dead desktops: the
# test was `readlink -f "$path" == $DOTFILES/*`, and readlink -f prints a path
# whose FINAL component does not exist. Delete the repo's .config/niri and
# ~/.config/niri -> $DOTFILES/.config/niri still printed a green OK on a
# machine with no compositor config at all. `-e` on the link is the test that
# follows through; a prefix test only ever answers "where does it aim".
#
# The list of links is built from both sides on purpose: what the repo would
# deploy, AND what is already deployed into $HOME pointing at the repo. Repo
# side alone repeats the same bug one level up -- delete the tracked config and
# the link into it stops being checked at all.
#
# Units and .local/bin scripts are enumerated the way link_dotfiles() does. The
# two by-name lists below are copies of its literals; bash cannot share them
# with the Rust, so tests/dotfiles-check.sh diffs `dotfiles-check --list`
# against src/main.rs and fails when the two drift.
#
# Usage: dotfiles-check          (run any time; exits 1 if anything is red)
#        dotfiles-check --list   (repo-relative paths it expects deployed)
# Override repo path: DOTFILES_REPO=/path/to/repo dotfiles-check  (DOTFILES also works)
# DOTFILES_CHECK_ROOT=/path prefixes the system paths it reads (/etc, /usr); for tests.
set -uo pipefail
# An empty .local/bin or systemd/user must expand to nothing rather than to a
# literal '*', and dotctl links dot-prefixed files in those dirs too.
shopt -s nullglob dotglob

# dotctl's own flag is `#[arg(long, env = "DOTFILES_REPO")]`, so DOTFILES_REPO
# is the name a user cloning elsewhere has already set; consult it first or this
# check aims at the default path while dotctl deploys to another and reports FAIL
# for links that are fine -- the one job it has. DOTFILES stays honoured so
# existing muscle memory keeps working: DOTFILES_REPO > DOTFILES > default.
DOTFILES="${DOTFILES_REPO:-${DOTFILES:-$HOME/niri-dotfiles}}"

# Mirrors of the two by-name lists in link_dotfiles() (src/main.rs), in the
# same order as the Rust so a drift diff reads cleanly.
CONFIG_ITEMS=(
  teleia nvim noctalia fastfetch tmux fuzzel gtk-3.0 gtk-4.0 kitty
  lazygit niri opencode qt5ct qt6ct starship.toml
)
HOME_ITEMS=(.zshrc .editorconfig .gitignore_global)
# setup_gitconfig() links the tracked .gitconfig to a neutral XDG path. The
# real ~/.gitconfig is deliberately a plain file -- a stub that [include]s it --
# so it is NOT checked as a symlink here.
GITCONFIG_DEST=".config/git/dotfiles.config"

if [[ "${1:-}" == "--list" ]]; then
  # The static candidates only: the part of the deploy this file duplicates by
  # name. Units and bin scripts are read out of the repo and cannot drift.
  for _d in "${CONFIG_ITEMS[@]}"; do printf '.config/%s\n' "$_d"; done
  for _f in "${HOME_ITEMS[@]}"; do printf '%s\n' "$_f"; done
  printf '.gitconfig\n'
  exit 0
fi

fail=0
skipped=0

if [[ -t 1 ]]; then
  GRN='\033[0;32m'; RED='\033[0;31m'; YLW='\033[1;33m'; RST='\033[0m'
else
  GRN=''; RED=''; YLW=''; RST=''
fi
ok()   { echo -e "  ${GRN}OK${RST}   $*"; }
bad()  { echo -e "  ${RED}FAIL${RST} $*"; fail=$((fail + 1)); }
warn() { echo -e "  ${YLW}WARN${RST} $*"; }
# SKIP is for what is genuinely optional -- a host with no user systemd manager
# to have failed. It must never stand in for a check that could have gone red:
# skip() deliberately does not touch $fail, so every state that can be unwell
# goes through bad() instead, and the summary prints the skip count so a run
# that skipped something never looks like a clean one.
skip() { echo -e "  ${YLW}SKIP${RST} $*"; skipped=$((skipped + 1)); }

echo "==> Failed user systemd units"
if ! command -v systemctl >/dev/null 2>&1; then
  skip "systemctl not found; no user units to check"
elif ! systemctl --user list-units --no-legend --plain >/dev/null 2>&1; then
  # ssh without lingering, a chroot, CI: there is no user manager, so there are
  # no units to have failed. Genuinely optional, unlike anything below.
  skip "no user systemd manager reachable (not a graphical session?)"
else
  mapfile -t failed < <(systemctl --user list-units --state=failed --no-legend --plain 2>/dev/null | awk 'NF {print $1}')
  if (( ${#failed[@]} == 0 )); then
    ok "no failed units"
  else
    for u in "${failed[@]}"; do bad "$u (systemctl --user status $u)"; done
  fi
fi

echo "==> Noctalia shell"
# niri starts it (spawn-at-startup "noctalia"); without it the session has no
# bar, no notifications and no lock screen, and nothing else says so -- the
# v4 -> v5 update left exactly that, a spawn of a shell that no longer existed.
# Asked over its own IPC, with a timeout so a wedged shell cannot hang this.
if ! command -v noctalia >/dev/null 2>&1; then
  bad "noctalia not installed -- no bar, notifications or lock screen (run \`dotctl install\`)"
elif [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
  skip "not in a Wayland session, so the shell cannot be asked"
elif timeout 5 noctalia msg status >/dev/null 2>&1; then
  ok "Noctalia is running"
else
  bad "Noctalia is installed but not answering -- no bar, notifications or lock screen (start it: \`niri msg action spawn -- noctalia\`)"
fi

echo "==> Symlinks resolve into \$DOTFILES ($DOTFILES)"
# An absent repo is the worst state this script can be run in: every deployed
# link is dangling by definition. It used to skip() here and then print
# "OK: all checks passed" -- the one answer that must never come out of a
# machine in this state.
if [[ ! -d "$DOTFILES" ]]; then
  bad "\$DOTFILES does not exist: $DOTFILES (export DOTFILES_REPO=/path/to/repo)"
else
  DOTFILES_CANON="$(readlink -m -- "$DOTFILES")"

  # True when $1 is a symlink aiming into the repo -- i.e. something a deploy
  # put there, whether or not it still resolves. This is what lets a link whose
  # tracked target was deleted stay on the list.
  aims_into_repo() {
    [[ -L "$1" ]] || return 1
    local abs
    abs="$(readlink -m -- "$1")"
    [[ "$abs" == "$DOTFILES_CANON" || "$abs" == "$DOTFILES_CANON"/* ]]
  }

  declare -A seen=()
  paths=()  # deployed paths, in report order
  srcs=()   # the repo path each one must point at
  want() {
    [[ -n "${seen[$1]:-}" ]] && return 0
    seen["$1"]=1
    paths+=("$1")
    srcs+=("$2")
  }

  # By-name candidates: on the list if the repo tracks it (link_dotfiles links
  # a path only `if src.exists()`) or if $HOME already holds a link into the
  # repo for it.
  for d in "${CONFIG_ITEMS[@]}"; do
    if [[ -e "$DOTFILES/.config/$d" ]] || aims_into_repo "$HOME/.config/$d"; then
      want "$HOME/.config/$d" "$DOTFILES/.config/$d"
    fi
  done
  for f in "${HOME_ITEMS[@]}"; do
    if [[ -e "$DOTFILES/$f" ]] || aims_into_repo "$HOME/$f"; then
      want "$HOME/$f" "$DOTFILES/$f"
    fi
  done
  if [[ -e "$DOTFILES/.gitconfig" ]] || aims_into_repo "$HOME/$GITCONFIG_DEST"; then
    want "$HOME/$GITCONFIG_DEST" "$DOTFILES/.gitconfig"
  fi

  # Units and scripts are linked file by file, not as whole directories. Repo
  # side first (skipping symlinks, as read_dir()/is_file() does), then whatever
  # a past deploy left in the destination dirs -- that half is what catches a
  # unit link whose tracked file has since been deleted or renamed.
  for f in "$DOTFILES"/.config/systemd/user/*; do
    [[ -L "$f" ]] && continue
    [[ -f "$f" ]] && want "$HOME/.config/systemd/user/${f##*/}" "$f"
  done
  for p in "$HOME"/.config/systemd/user/*; do
    aims_into_repo "$p" && want "$p" "$DOTFILES/.config/systemd/user/${p##*/}"
  done
  for f in "$DOTFILES"/.local/bin/*; do
    [[ -L "$f" ]] && continue
    [[ -f "$f" ]] && want "$HOME/.local/bin/${f##*/}" "$f"
  done
  for p in "$HOME"/.local/bin/*; do
    aims_into_repo "$p" && want "$p" "$DOTFILES/.local/bin/${p##*/}"
  done

  if (( ${#paths[@]} == 0 )); then
    # A repo that exists but tracks nothing we deploy: an interrupted clone, or
    # $DOTFILES aimed at the wrong directory. With an empty list every check
    # below passes vacuously -- the same false green as the old skip.
    bad "$DOTFILES tracks none of the paths dotctl deploys (wrong \$DOTFILES, or a partial clone?)"
  fi

  for i in "${!paths[@]}"; do
    path="${paths[$i]}"
    src="${srcs[$i]}"
    if [[ ! -L "$path" ]]; then
      if [[ -d "$path" ]]; then
        bad "$path is a real directory, not a symlink (expected -> $src)"
      elif [[ -e "$path" ]]; then
        bad "$path is a real file, not a symlink (expected -> $src)"
      else
        bad "$path is missing (expected -> $src)"
      fi
      continue
    fi
    tgt="$(readlink -- "$path")"
    # readlink -m normalises a path that need not exist, so this answers "where
    # does it aim" and nothing more. Whether it ARRIVES is the -e below, on the
    # link itself -- the half whose absence made this script useless.
    abs="$(readlink -m -- "$path")"
    if [[ "$abs" != "$DOTFILES_CANON" && "$abs" != "$DOTFILES_CANON"/* ]]; then
      bad "$path -> $tgt (outside repo)"
    elif [[ ! -e "$path" ]]; then
      bad "$path -> $tgt (dangling: target does not exist; run \`dotctl deploy\`)"
    elif [[ "$abs" != "$(readlink -m -- "$src")" ]]; then
      # Resolves, and into the repo, so the desktop works -- but it is not what
      # a deploy lays down, so the next `dotctl deploy` will move it aside.
      warn "$path -> $tgt (into the repo, but not at $src)"
    else
      ok "$path"
    fi
  done
fi

# Everything below checks what `dotctl install` sets up rather than what deploy
# links. The tracked configs call these by name, so a missing one is a binding,
# a language server or an MCP server that silently does nothing.
echo "==> Programs the tracked configs call"
TOOLS=(
  "npx|teleia's and opencode's npx-launched MCP servers"
  "github-mcp-server|the GitHub MCP server (~/.local/bin/github-mcp)"
  "secret-tool|the keyring lookups for the GitHub token and avante's key"
  "lazygit|Neovim's <leader>gG and tmux's C-a g"
  "clangd|teleia's C/C++ language server"
  "pkgfile|zsh's command-not-found package hints"
)
for entry in "${TOOLS[@]}"; do
  tool="${entry%%|*}"
  if command -v "$tool" >/dev/null 2>&1; then
    ok "$tool"
  else
    bad "$tool not installed -- ${entry#*|} (run \`dotctl install\`)"
  fi
done
# rustup's rust-analyzer proxy is on PATH whether or not the component is
# installed, so ask it to run rather than whether it exists.
if rust-analyzer --version >/dev/null 2>&1; then
  ok "rust-analyzer"
else
  bad "rust-analyzer does not run -- teleia's Rust language server (run \`dotctl install\`)"
fi

echo "==> HexStrike answers only loopback names"
# The bind itself is verified where it matters, at every start, by
# hexstrike-assert-loopback; a failure there surfaces as a failed unit above.
# Nothing at runtime checks the Host guard, so it is checked here, by the same
# sentinel patch_hexstrike_host_guard() uses (src/main.rs HOST_GUARD_SENTINEL).
HEX_SERVER="$HOME/tools/hexstrike-ai/hexstrike_server.py"
if [[ ! -f "$HEX_SERVER" ]]; then
  skip "HexStrike not installed ($HEX_SERVER absent)"
elif [[ "$(<"$HEX_SERVER")" == *"# dotctl: loopback-Host guard."* ]]; then
  ok "Host guard present in $HEX_SERVER"
else
  bad "no loopback-Host guard in $HEX_SERVER -- a web page that DNS-rebinds to 127.0.0.1 could drive /api/command (run \`dotctl install\`)"
fi

echo "==> Keyring secrets"
if ! command -v secret-tool >/dev/null 2>&1; then
  skip "secret-tool not installed (reported above)"
else
  for svc in github-mcp-server anthropic; do
    if secret-tool lookup service "$svc" >/dev/null 2>&1; then
      ok "something is stored under service $svc"
    else
      # A choice, not a fault: without it one feature has no key.
      warn "nothing stored under service $svc -- see the README's Secrets section"
    fi
  done
  # GitHub reports a fine-grained token's expiry in a response header. Ask once,
  # with the token piped into a header -- never in argv, never printed.
  if secret-tool lookup service github-mcp-server >/dev/null 2>&1; then
    headers="$({ printf 'Authorization: Bearer '; secret-tool lookup service github-mcp-server; } |
      curl -s --max-time 10 -o /dev/null -D - -H @- https://api.github.com/user 2>/dev/null)"
    status="" expiry=""
    while IFS= read -r line; do
      line="${line%$'\r'}"
      case "$line" in
        HTTP/*) status="${line#* }"; status="${status%% *}" ;;
        [Gg]ithub-[Aa]uthentication-[Tt]oken-[Ee]xpiration:*) expiry="${line#*: }" ;;
      esac
    done <<<"$headers"
    if [[ -z "$status" ]]; then
      skip "could not reach api.github.com to check the GitHub token"
    elif [[ "$status" == 401 ]]; then
      bad "GitHub rejects the stored token (expired or revoked) -- regenerate it and store it again"
    elif [[ "$status" != 200 ]]; then
      warn "GitHub answered HTTP $status for the stored token"
    elif [[ -z "$expiry" ]]; then
      ok "GitHub accepts the stored token (no expiry)"
    else
      left=$(( ($(date -d "$expiry" +%s) - $(date +%s)) / 86400 ))
      if (( left < 14 )); then
        warn "the GitHub token expires in $left day(s), on $expiry -- regenerate it and store it again"
      else
        ok "GitHub accepts the stored token, valid until $expiry"
      fi
    fi
  fi
fi

echo "==> pkgfile database"
if ! command -v pkgfile >/dev/null 2>&1; then
  skip "pkgfile not installed (reported above)"
elif pkgfile -b pkgfile >/dev/null 2>&1; then
  ok "present -- command-not-found can name packages"
else
  warn "no database yet -- pkgfile-update.timer builds it daily; \`sudo pkgfile -u\` builds it now"
fi

echo "==> Theme"
# grogu repaints the desktop on every wallpaper change, and since 0.2.0 it also
# writes Noctalia's palette; an older one fails at its first step and repaints
# nothing at all. The hook calls ~/.cargo/bin/grogu, which may not be on PATH.
GROGU="$(command -v grogu 2>/dev/null || true)"
[[ -z "$GROGU" && -x "$HOME/.cargo/bin/grogu" ]] && GROGU="$HOME/.cargo/bin/grogu"
if [[ -z "$GROGU" ]]; then
  bad "grogu not installed -- wallpaper changes repaint nothing (run \`dotctl install\`)"
else
  ver="$("$GROGU" --version 2>/dev/null)"
  ver="${ver#* }"
  if [[ ! "$ver" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+) ]]; then
    bad "grogu reports no version -- reinstall it (run \`dotctl install\`)"
  elif (( 10#${BASH_REMATCH[1]} == 0 && 10#${BASH_REMATCH[2]} < 2 )); then
    bad "grogu $ver predates 0.2.0 and cannot write Noctalia v5's palette (run \`dotctl install\`)"
  else
    ok "grogu $ver"
  fi
fi
if [[ -f "$HOME/.config/noctalia/palettes/Grogu.json" ]]; then
  ok "Noctalia's Grogu palette present"
else
  warn "no Grogu palette yet -- Noctalia shows its built-in one until grogu runs (the next wallpaper change, or \`grogu apply --extract --reload\`)"
fi

echo "==> Login screens"
# What `dotctl install` points them at. A package update can take the file
# away: Noctalia's move to v5 deleted the image ReGreet's background named.
ROOT="${DOTFILES_CHECK_ROOT:-}"
SDDM_CONF="$ROOT/etc/sddm.conf.d/10-noctalia-theme.conf"
if [[ ! -f "$SDDM_CONF" ]]; then
  skip "no SDDM theme drop-in ($SDDM_CONF absent)"
else
  # Read, not assumed: .local/bin/sddm-theme switches it.
  theme=""
  while IFS='=' read -r key value; do
    [[ "$key" == Current ]] && theme="$value"
  done <"$SDDM_CONF"
  if [[ -z "$theme" ]]; then
    warn "$SDDM_CONF names no theme -- SDDM shows its default"
  elif [[ -d "$ROOT/usr/share/sddm/themes/$theme" ]]; then
    ok "SDDM theme $theme installed"
  else
    bad "SDDM theme $theme is not installed -- the login screen falls back to SDDM's default (run \`dotctl install\`)"
  fi
fi
# The greetd fallback, disabled while SDDM runs, so its loss is a warning.
REGREET="$ROOT/etc/greetd/regreet.toml"
if [[ ! -f "$REGREET" ]]; then
  skip "no ReGreet config ($REGREET absent)"
else
  bg=""
  while IFS= read -r line; do
    if [[ "$line" =~ ^path[[:space:]]*=[[:space:]]*\"(.*)\" ]]; then
      bg="${BASH_REMATCH[1]}"
      break
    fi
  done <"$REGREET"
  if [[ -z "$bg" ]]; then
    warn "$REGREET names no background"
  elif [[ -f "$ROOT$bg" ]]; then
    ok "ReGreet background present ($bg)"
  else
    warn "ReGreet's background $bg is gone -- the fallback greeter shows none (run \`dotctl install\`)"
  fi
fi

echo "==> Wallpapers"
if [[ -d "$DOTFILES/wallpapers/.git" ]]; then
  ok "private wallpapers clone present ($DOTFILES/wallpapers)"
else
  skip "no wallpapers clone (owner-only: \`dotctl all\` clones foolish-dev/niri-wallpapers)"
fi

echo
if (( fail )); then
  echo -e "${RED}FAIL${RST}: $fail check(s) failed"
  exit 1
fi
if (( skipped )); then
  echo -e "${GRN}OK${RST}: all checks passed ($skipped skipped)"
  exit 0
fi
echo -e "${GRN}OK${RST}: all checks passed"
